    {
      "parameters": {
        "promptType": "define",
        "text": "=Analyze this email and determine if it is a real estate lead.\n\nFrom: {{ $json.from }}\nSubject: {{ $json.subject }}\nSnippet: {{ $json.snippet }}",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "You are a real estate lead-qualification assistant screening a real estate agency inbox. For each email, decide (1) isRealEstateLead: whether the email relates to buying, selling, renting, or investing in property, and (2) qualified: true only if the sender shows genuine, actionable intent - such as a stated budget, timeline, specific property interest, or a request to view/schedule - rather than spam, a newsletter, a vague question, or an unrelated message. Extract any lead details you can find. Always explain your reasoning briefly."
        }
      },
      "id": "519bf5d2-f2ed-4750-873d-3e536021f60d",
