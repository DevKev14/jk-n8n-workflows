    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "={\n  \"type\": \"object\",\n  \"properties\": {\n    \"email\": {\n      \"type\": \"string\",\n      \"description\": \"Email address of the lead.\"\n    },\n    \"segment\": {\n      \"type\": \"string\",\n      \"enum\": [\"warm_stalled\", \"price_sensitive\", \"wrong_timing\", \"cold\"],\n      \"description\": \"Classify into exactly one segment based on lead history: warm_stalled, price_sensitive, wrong_timing, or cold.\"\n    },\n    \"confidence_score\": {\n      \"type\": \"number\",\n      \"minimum\": 0,\n      \"maximum\": 1,\n      \"description\": \"Confidence score of the segment classification between 0.0 and 1.0.\"\n    },\n    \"channel\": {\n      \"type\": \"string\",\n      \"enum\": [\"email\", \"sms\"],\n      \"description\": \"The determined or provided communication channel ('email' or 'sms').\"\n    },\n    \"channel_dropdown\": {\n      \"type\": \"string\",\n      \"enum\": [\"email\", \"sms\"],\n      \"description\": \"Channel dropdown field - mirror of the chosen communication channel ('email' or 'sms').\"\n    },\n    \"label\": {\n      \"type\": \"string\",\n      \"description\": \"Set to 'Email-Campaign' if channel is email. Leave empty or null if channel is sms.\"\n    },\n    \"subject\": {\n      \"type\": \"string\",\n      \"description\": \"Email subject line tailored to the lead and segment. Leave as an empty string if channel is sms.\"\n    },\n    \"reasoning\": {\n      \"type\": \"string\",\n      \"description\": \"Brief explanation of the chosen segment.\"\n    },\n    \"message\": {\n      \"type\": \"string\",\n      \"description\": \"Personalized re-engagement message body only. Ends with 'Best Regards, ABC Company'. Do NOT include the subject line inside this message field. If email, keep body under 120 words. If sms, keep message strictly under 400 characters.\"\n    }\n  },\n  \"required\": [\n    \"email\",\n    \"segment\",\n    \"confidence_score\",\n    \"channel\",\n    \"channel_dropdown\",\n    \"subject\",\n    \"reasoning\",\n    \"message\"\n  ]\n}"
      },
